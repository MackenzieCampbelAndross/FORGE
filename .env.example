# ==============================================================================
# FORGE v1.0 Configuration
# Copy this file to .env and configure as required.
# ==============================================================================

# Model Provider ('gemini' or 'mock')
FORGE_MODEL_PROVIDER=mock

# Google Gemini API Key (Required when FORGE_MODEL_PROVIDER=gemini)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Name (e.g. gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash)
FORGE_GEMINI_MODEL=gemini-1.5-flash

# Orchestration & Revision
FORGE_MAX_REVISIONS=3
FORGE_TEMPERATURE=0.2
FORGE_TIMEOUT_SECONDS=60
FORGE_MAX_RETRIES=3

# Database Configuration (SQLite by default, or PostgreSQL)
# Example PostgreSQL: postgresql+psycopg2://forge:forge@localhost:5432/forge_db
FORGE_DATABASE_URL=sqlite:///./forge.db

# Redis Configuration (Optional for caching/async execution)
FORGE_REDIS_URL=redis://localhost:6379/0

# Observability & Logging
FORGE_LOG_LEVEL=INFO
FORGE_LOG_FORMAT=json
FORGE_ENABLE_TELEMETRY=false

# MLflow Experiment Tracking
FORGE_MLFLOW_TRACKING_URI=./mlruns
FORGE_MLFLOW_EXPERIMENT_NAME=FORGE_Benchmark_v1.0
